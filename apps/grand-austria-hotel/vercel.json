{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "headers": [{ "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }],
  "functions": { "api/index.mjs": { "maxDuration": 15 } }
}
