.about-avatar
  position relative
  margin -8rem auto 1rem
  width 10rem
  height 10rem
  z-index 3

  img
    width 100%
    height 100%
    border-radius 50%
    background-color transparent
    object-fit cover
    box-shadow 0 2px 5px 0 rgba(0,0,0, 0.11), 0 2px 10px 0 rgba(0, 0, 0, 1) // 头像框周围黑色包裹线条


.about-info
  & > div
    margin-bottom .5rem

.about-name
  font-size 1.75rem
  font-weight bold

.about-intro
  max-width 48rem
  margin 1.25rem auto 1rem
  padding 0 1rem
  font-size 1rem
  line-height 1.9
  text-align left

  & > p
    margin 0 0 .85rem

  & > p:last-child
    margin-bottom 0

.about-icons
  & > a:not(:last-child)
    margin-right .5rem

  & > a > i
    font-size 1.5rem
